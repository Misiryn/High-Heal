---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  activeNav?: 'home' | 'services' | 'sports-physio' | 'corporate' | 'about' | 'contact';
}

const {
  title = "High Heal | Elite Sports Medicine & Advanced Physiotherapy",
  description = "Ahmedabad's premier sports physiotherapy and performance clinic. Evidence-based injury rehabilitation, biomechanical gait analysis, and Olympic-grade recovery.",
  activeNav = 'home'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="sports physiotherapy, sports medicine Ahmedabad, ACL rehabilitation, gait analysis, rotator cuff physio, dry needling, corporate ergonomics" />
    
    <!-- Open Graph / WhatsApp Previews -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="High Heal Sports Medicine" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />

    <!-- Schema.org Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "MedicalBusiness",
        "name": "High Heal Sports Medicine & Physiotherapy",
        "description": "Evidence-based sports physiotherapy, post-operative rehabilitation, and biomechanical performance clinic.",
        "telephone": "+919876543210",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Prime Commercial Boulevard",
          "addressLocality": "Ahmedabad",
          "addressRegion": "Gujarat",
          "postalCode": "380054",
          "addressCountry": "IN"
        },
        "medicalSpecialty": ["PhysicalTherapy", "SportsMedicine"]
      }
    </script>
  </head>
  <body class="relative text-slate-900 bg-slate-50 antialiased selection:bg-teal-500/20 selection:text-teal-900">
    
    <!-- Ambient Subtle Clinical Glow -->
    <div class="ambient-glow"></div>
    <div class="fixed top-1/4 -left-48 w-96 h-96 bg-teal-500/5 rounded-full blur-3xl pointer-events-none"></div>
    <div class="fixed bottom-10 -right-48 w-96 h-96 bg-sky-500/5 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Sticky Clean Medical Navigation -->
    <header class="sticky top-0 z-50 glass-nav transition-all">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        
        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-teal-600 to-cyan-600 flex items-center justify-center font-black text-white text-xl tracking-tighter shadow-md shadow-teal-600/20 group-hover:scale-105 transition">
            H+
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="font-extrabold text-slate-900 tracking-tight text-xl">HIGH HEAL</span>
              <span class="badge-medical text-[10px] px-2 py-0.5 rounded-full uppercase tracking-wider font-semibold font-mono">Clinic</span>
            </div>
            <p class="text-[11px] text-slate-500 hidden sm:block">Sports Medicine & Advanced Physiotherapy</p>
          </div>
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden md:flex items-center gap-1 bg-slate-100/90 p-1.5 rounded-2xl border border-slate-200/80 text-xs font-medium">
          <a href="/" class={`px-4 py-2 rounded-xl transition ${activeNav === 'home' ? 'bg-white text-teal-800 font-bold shadow-sm border border-slate-200/60' : 'text-slate-600 hover:text-slate-900'}`}>Home</a>
          <a href="/services" class={`px-4 py-2 rounded-xl transition ${activeNav === 'services' ? 'bg-white text-teal-800 font-bold shadow-sm border border-slate-200/60' : 'text-slate-600 hover:text-slate-900'}`}>Services</a>
          <a href="/sports-physio" class={`px-4 py-2 rounded-xl transition ${activeNav === 'sports-physio' ? 'bg-white text-teal-800 font-bold shadow-sm border border-slate-200/60' : 'text-slate-600 hover:text-slate-900'}`}>Sports Physio</a>
          <a href="/corporate-wellness" class={`px-4 py-2 rounded-xl transition ${activeNav === 'corporate' ? 'bg-white text-teal-800 font-bold shadow-sm border border-slate-200/60' : 'text-slate-600 hover:text-slate-900'}`}>Corporate</a>
          <a href="/about" class={`px-4 py-2 rounded-xl transition ${activeNav === 'about' ? 'bg-white text-teal-800 font-bold shadow-sm border border-slate-200/60' : 'text-slate-600 hover:text-slate-900'}`}>About Doctor</a>
          <a href="/contact" class={`px-4 py-2 rounded-xl transition ${activeNav === 'contact' ? 'bg-white text-teal-800 font-bold shadow-sm border border-slate-200/60' : 'text-slate-600 hover:text-slate-900'}`}>Contact</a>
        </nav>

        <!-- Right CTA Button -->
        <div class="flex items-center gap-3">
          <a href="/contact" class="hidden sm:inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-teal-600 text-white font-bold text-xs hover:bg-teal-700 transition shadow-md shadow-teal-600/25">
            <span>Book Clinical Visit</span>
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-200 animate-ping"></span>
          </a>

          <!-- Mobile Menu Toggle Button -->
          <button id="mobile-menu-btn" aria-label="Toggle menu" class="md:hidden p-2 rounded-xl bg-slate-100 border border-slate-200 text-slate-700">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
            </svg>
          </button>
        </div>

      </div>

      <!-- Mobile Dropdown Menu -->
      <div id="mobile-menu" class="hidden md:hidden px-4 pt-2 pb-6 bg-white border-b border-slate-200 space-y-2 shadow-lg">
        <a href="/" class="block px-3 py-2 rounded-lg text-sm text-slate-700 hover:bg-slate-100">Home</a>
        <a href="/services" class="block px-3 py-2 rounded-lg text-sm text-slate-700 hover:bg-slate-100">Services</a>
        <a href="/sports-physio" class="block px-3 py-2 rounded-lg text-sm text-slate-700 hover:bg-slate-100">Sports Physio</a>
        <a href="/corporate-wellness" class="block px-3 py-2 rounded-lg text-sm text-slate-700 hover:bg-slate-100">Corporate Wellness</a>
        <a href="/about" class="block px-3 py-2 rounded-lg text-sm text-slate-700 hover:bg-slate-100">About Doctor</a>
        <a href="/contact" class="block px-3 py-2 rounded-lg text-sm text-slate-700 hover:bg-slate-100">Contact & Booking</a>
        <div class="pt-2">
          <a href="/contact" class="block w-full text-center py-3 rounded-xl bg-teal-600 text-white font-bold text-xs">Book Appointment</a>
        </div>
      </div>
    </header>

    <!-- Page Content Slot -->
    <main class="relative z-10">
      <slot />
    </main>

    <!-- Global Floating WhatsApp Action -->
    <div class="fixed bottom-6 right-6 z-40">
      <a 
        href="https://wa.me/919876543210?text=Hello%20High%20Heal%2C%20I%20would%20like%20to%20inquire%20about%20a%20physiotherapy%20consultation." 
        target="_blank" 
        rel="noopener noreferrer"
        class="flex items-center gap-2.5 px-4 py-3 rounded-full bg-emerald-600 text-white font-bold text-xs shadow-xl shadow-emerald-600/30 hover:scale-105 hover:bg-emerald-500 transition"
        title="Instant WhatsApp Consultation"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.072-2.18-.544-1.898-.788-3.123-2.73-3.218-2.855-.095-.126-.77-1.025-.77-1.954 0-.929.486-1.386.659-1.576.174-.189.38-.237.506-.237.126 0 .253.002.363.007.116.005.27-.044.423.323.158.38.539 1.314.587 1.409.047.095.079.206.016.332-.063.126-.095.205-.189.316-.095.11-.2.246-.285.33-.095.095-.195.199-.084.389.111.19.493.813 1.057 1.315.727.646 1.34.846 1.531.941.19.095.301.079.412-.047.111-.127.475-.554.602-.744.127-.19.253-.158.428-.095.174.063 1.109.522 1.3.617.19.095.317.143.364.222.048.079.048.459-.096.864z"/>
        </svg>
        <span class="hidden sm:inline">WhatsApp Us</span>
      </a>
    </div>

    <!-- Master Footer (Trustworthy Clinical Navy) -->
    <footer class="mt-28 border-t border-slate-800 bg-slate-900 text-slate-300 pt-16 pb-12 relative z-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-10">
          
          <!-- Clinic Info Column -->
          <div class="md:col-span-4 space-y-4">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-teal-500 to-cyan-400 flex items-center justify-center font-extrabold text-white text-base shadow-md shadow-teal-500/20">
                H+
              </div>
              <span class="font-extrabold text-white text-lg tracking-tight">HIGH HEAL</span>
            </div>
            <p class="text-xs text-slate-400 leading-relaxed max-w-sm">
              Ahmedabad's dedicated sports rehabilitation center blending evidence-based physical therapy, biomechanical motion capture, and performance conditioning.
            </p>
            <div class="text-xs text-slate-400 space-y-1">
              <p>📍 Prime Commercial Hub, Sindhu Bhavan Road / Bodakdev, Ahmedabad, Gujarat</p>
              <p>⏰ Mon – Sat: 8:00 AM – 8:30 PM | Sunday: By Appointment</p>
              <p>📞 Direct Phone: +91 98765 43210</p>
            </div>
          </div>

          <!-- Quick Links -->
          <div class="md:col-span-2 space-y-3">
            <h4 class="text-xs uppercase font-mono tracking-wider text-white font-semibold">Clinical Scope</h4>
            <ul class="text-xs text-slate-400 space-y-2">
              <li><a href="/services" class="hover:text-teal-300 transition">Post-Op Rehab</a></li>
              <li><a href="/services" class="hover:text-teal-300 transition">Spine & Disc Relief</a></li>
              <li><a href="/services" class="hover:text-teal-300 transition">Gait Biomechanics</a></li>
              <li><a href="/services" class="hover:text-teal-300 transition">Dry Needling & IASTM</a></li>
              <li><a href="/services" class="hover:text-teal-300 transition">Shockwave Therapy</a></li>
            </ul>
          </div>

          <!-- Sports Divisions -->
          <div class="md:col-span-3 space-y-3">
            <h4 class="text-xs uppercase font-mono tracking-wider text-white font-semibold">Athletic Programs</h4>
            <ul class="text-xs text-slate-400 space-y-2">
              <li><a href="/sports-physio" class="hover:text-teal-300 transition">Marathon & Runners Clinic</a></li>
              <li><a href="/sports-physio" class="hover:text-teal-300 transition">Cricket & Fast Bowler Protocols</a></li>
              <li><a href="/sports-physio" class="hover:text-teal-300 transition">ACL Return-to-Sport Testing</a></li>
              <li><a href="/corporate-wellness" class="hover:text-teal-300 transition">Corporate Ergonomics & Audits</a></li>
              <li><a href="/corporate-wellness" class="hover:text-teal-300 transition">Executive Posture Masterclass</a></li>
            </ul>
          </div>

          <!-- Direct Appointment Column -->
          <div class="md:col-span-3 space-y-3">
            <h4 class="text-xs uppercase font-mono tracking-wider text-white font-semibold">Appointments</h4>
            <p class="text-xs text-slate-400">Slots are strictly scheduled 1-on-1 for personalized 45–60 minute care.</p>
            <div class="pt-2">
              <a href="/contact" class="block w-full text-center py-2.5 rounded-xl bg-teal-500 text-white font-bold text-xs hover:bg-teal-400 transition shadow-lg shadow-teal-500/20">
                Book Consultation Now →
              </a>
            </div>
          </div>

        </div>

        <div class="mt-12 pt-8 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400 gap-4">
          <p>© {new Date().getFullYear()} High Heal Sports Medicine & Physiotherapy. All rights reserved.</p>
          <div class="flex items-center gap-6">
            <a href="/contact" class="hover:text-slate-300">Emergency Trauma Care</a>
            <a href="/about" class="hover:text-slate-300">Clinical Philosophy</a>
            <a href="/contact" class="hover:text-slate-300">Location Map</a>
          </div>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      if (btn && menu) {
        btn.addEventListener('click', () => {
          menu.classList.toggle('hidden');
        });
      }
    </script>
  </body>
</html>
