---
import Layout from '../layouts/Layout.astro';
import BookingForm from '../components/BookingForm.tsx';

const faqs = [
  {
    q: "How long does the initial clinical consultation take?",
    a: "Every initial consultation lasts 45 to 60 minutes. This includes a full physical kinematic assessment, joint orthopedic testing, diagnosis review (MRI/X-Ray), and your first targeted treatment intervention."
  },
  {
    q: "Do I need a doctor's referral to book an appointment?",
    a: "No prior doctor referral is required. As licensed Sports Physiotherapists, we are primary healthcare practitioners qualified to conduct direct musculoskeletal assessments."
  },
  {
    q: "What should I wear for my evaluation?",
    a: "Please bring or wear comfortable athletic apparel (shorts, t-shirt, and running shoes) that allows unhindered assessment of your knees, hips, or shoulders."
  },
  {
    q: "Can I get same-day emergency appointments for acute injuries?",
    a: "Yes. We reserve daily emergency priority slots for acute ligament tears, sudden sport injuries, and severe lumbar disc flare-ups. Contact us directly via WhatsApp for fastest triage."
  },
  {
    q: "Are the treatments covered by health insurance?",
    a: "Physiotherapy coverage depends on your specific health insurance policy (OPD coverage). We provide official stamped clinical receipts with procedure codes (CPT) for reimbursement."
  }
];
---

<Layout activeNav="contact" title="Book Appointment & Contact | High Heal Sports Medicine">
  
  <!-- Header -->
  <section class="pt-16 pb-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto text-center">
    <div class="inline-flex items-center gap-2 badge-tech px-4 py-1.5 rounded-full text-xs font-semibold mb-4">
      <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
      1-on-1 Dedicated Consultations
    </div>
    <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight">
      Schedule Your Clinical Assessment
    </h1>
    <p class="text-slate-400 text-base max-w-xl mx-auto mt-4 leading-relaxed">
      Book your appointment online or reach out via WhatsApp for immediate slot confirmation.
    </p>
  </section>

  <!-- Main Booking Grid -->
  <section class="pb-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- Left Column: Clinic Contact Cards & Location -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- Quick Clinic Overview -->
        <div class="glass-panel rounded-3xl p-7 border border-white/10 space-y-6">
          <h3 class="text-xl font-bold text-white">Clinic Details</h3>

          <div class="space-y-4 text-xs">
            <div class="flex items-start gap-3.5">
              <div class="w-9 h-9 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center text-lg shrink-0">
                📍
              </div>
              <div>
                <strong class="text-white text-sm block">Location Address</strong>
                <span class="text-slate-400 leading-relaxed block mt-0.5">
                  High Heal Sports Medicine & Physiotherapy Centre<br />
                  Prime Commercial Boulevard, Sindhu Bhavan Road / Bodakdev,<br />
                  Ahmedabad, Gujarat 380054
                </span>
              </div>
            </div>

            <div class="flex items-start gap-3.5">
              <div class="w-9 h-9 rounded-xl bg-cyan-500/10 text-cyan-400 flex items-center justify-center text-lg shrink-0">
                ⏰
              </div>
              <div>
                <strong class="text-white text-sm block">Consultation Hours</strong>
                <span class="text-slate-400 block mt-0.5">
                  Monday – Saturday: 8:00 AM – 8:30 PM<br />
                  Sunday: By Prior Appointment Only
                </span>
              </div>
            </div>

            <div class="flex items-start gap-3.5">
              <div class="w-9 h-9 rounded-xl bg-purple-500/10 text-purple-400 flex items-center justify-center text-lg shrink-0">
                📞
              </div>
              <div>
                <strong class="text-white text-sm block">Direct Phone & Desk</strong>
                <span class="text-slate-400 block mt-0.5">
                  Clinic Desk: +91 98765 43210<br />
                  Emergency Trauma Helpline: +91 98765 43211
                </span>
              </div>
            </div>
          </div>

          <!-- Direct WhatsApp Quick Call Button -->
          <div class="pt-2">
            <a 
              href="https://wa.me/919876543210?text=Hello%20High%20Heal%2C%20I%20would%20like%20to%20inquire%20about%20a%20slot." 
              target="_blank"
              class="w-full py-3.5 rounded-2xl bg-emerald-500 text-slate-950 font-bold text-xs flex items-center justify-center gap-2 hover:bg-emerald-400 transition shadow-lg shadow-emerald-500/20"
            >
              <span>Instant Chat on WhatsApp</span>
              <span>💬 →</span>
            </a>
          </div>
        </div>

        <!-- Google Map Interactive Preview -->
        <div class="glass-panel rounded-3xl p-4 border border-white/10 overflow-hidden">
          <div class="w-full h-52 rounded-2xl bg-slate-900 border border-white/5 flex flex-col items-center justify-center text-center p-6 space-y-2">
            <div class="text-2xl">🗺️</div>
            <div class="text-xs font-bold text-white">Google Maps Direction</div>
            <p class="text-[11px] text-slate-400 max-w-xs">
              Centrally located with ample basement valet parking and wheelchair elevator access.
            </p>
            <a 
              href="https://maps.google.com" 
              target="_blank"
              class="text-[11px] font-mono text-emerald-400 underline mt-1"
            >
              Open in Google Maps App →
            </a>
          </div>
        </div>

      </div>

      <!-- Right Column: Interactive Booking Form Component -->
      <div class="lg:col-span-7">
        <BookingForm client:load />
      </div>

    </div>
  </section>

  <!-- FAQ Section -->
  <section class="pb-24 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
    <div class="text-center mb-10">
      <span class="badge-tech text-xs px-3 py-1 rounded-full font-mono uppercase tracking-wider font-semibold">
        Patient FAQs
      </span>
      <h2 class="text-3xl font-extrabold text-white mt-3">Frequently Asked Questions</h2>
    </div>

    <div class="space-y-4">
      {faqs.map((faq) => (
        <div class="glass-panel rounded-2xl p-6 border border-white/10">
          <h4 class="text-sm font-bold text-white leading-snug">{faq.q}</h4>
          <p class="text-xs text-slate-400 mt-2 leading-relaxed">{faq.a}</p>
        </div>
      ))}
    </div>
  </section>

</Layout>
