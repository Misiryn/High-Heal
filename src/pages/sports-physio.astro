---
import Layout from '../layouts/Layout.astro';
import ReturnToPlayTimeline from '../components/ReturnToPlayTimeline.tsx';

const sportsCategories = [
  {
    icon: "🏃",
    sport: "Endurance & Marathon Runners",
    tag: "Gait & Stride",
    injuries: "Patellofemoral pain, IT band friction syndrome, medial tibial stress (shin splints), plantar fasciitis, Achilles tendinopathy.",
    protocol: "Video gait kinetic breakdown, cadence optimization (170-180 spm), foot strike pattern retraining, and heavy soleus/glute loading."
  },
  {
    icon: "🏏",
    sport: "Cricket & Throwing Athletes",
    tag: "Fast Bowling & Shoulder",
    injuries: "Fast bowler lumbar pars stress reactions, rotator cuff tendinopathy, labral SLAP lesions, side strains.",
    protocol: "Kinetic chain power transfer from front-foot contact through pelvis to release, thoracic extension mobilization, and eccentric rotator cuff work."
  },
  {
    icon: "⚽",
    sport: "Football & Field Sports",
    tag: "High Velocity Cutting",
    injuries: "ACL ruptures, hamstring strains (biceps femoris), adductor longus groin pulls, syndesmotic ankle sprains.",
    protocol: "Nordic hamstring eccentric curls, Copenhagen groin protocols, change-of-direction deceleration mechanics, and perturbation drills."
  },
  {
    icon: "🏸",
    sport: "Badminton, Tennis & Racket Sports",
    tag: "Agility & Upper Limb",
    injuries: "Lateral epicondylalgia (tennis elbow), wrist TFCC tears, patellar tendinopathy, calf strain.",
    protocol: "Forearm extensor eccentric Tyler twists, lunging deceleration deceleration knee tracking, and overhead scapular stability."
  },
  {
    icon: "🏋️",
    sport: "CrossFit & Strength Athletes",
    tag: "Heavy Load Resistance",
    injuries: "Lumbar disc bulge during deadlifts, shoulder impingement on snatch, hip FAI on deep squat.",
    protocol: "Barbell kinematic bar-path analysis, intra-abdominal pressure bracing coaching, and glute-hip mobility openers."
  },
  {
    icon: "🏊",
    sport: "Swimmers & Triathletes",
    tag: "Hypermobility & Cadence",
    injuries: "Swimmer's shoulder impingement, breaststroker's knee, lower cervical spine stiffness.",
    protocol: "Scapular dynamic endurance, thoracic rotation restoration, and core anti-extension endurance."
  }
];
---

<Layout activeNav="sports-physio" title="Sports Physiotherapy & Athletic Performance | High Heal">
  
  <!-- Header -->
  <section class="pt-16 pb-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto text-center">
    <div class="inline-flex items-center gap-2 badge-tech px-4 py-1.5 rounded-full text-xs font-semibold mb-4">
      <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
      Specialized Division for Competitive & Recreational Athletes
    </div>
    <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight">
      Engineered for the Physical Demands of Sport
    </h1>
    <p class="text-slate-400 text-base max-w-2xl mx-auto mt-4 leading-relaxed">
      Athletes require a vastly different clinical approach than non-active patients. We understand training volume, periodization, and the psychological drive to get back in the game.
    </p>
  </section>

  <!-- Interactive Return to Play Component -->
  <section class="pb-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <ReturnToPlayTimeline client:load />
  </section>

  <!-- Sport by Sport Breakdown Grid -->
  <section class="py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="badge-tech text-xs px-3 py-1 rounded-full font-mono uppercase tracking-wider font-semibold">
        Sport-Specific Diagnostics
      </span>
      <h2 class="text-3xl font-extrabold text-white mt-3">Tailored By Athletic Discipline</h2>
      <p class="text-slate-400 text-xs mt-2">Every sport imposes unique vectors of torque, shear stress, and repetitive load.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sportsCategories.map((item) => (
        <div class="glass-panel glass-panel-hover rounded-3xl p-7 border border-white/10 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-3xl">{item.icon}</span>
              <span class="badge-tech text-[10px] font-mono px-2.5 py-0.5 rounded-full font-semibold">
                {item.tag}
              </span>
            </div>

            <h3 class="text-xl font-bold text-white leading-snug">
              {item.sport}
            </h3>

            <div class="mt-4 pt-3 border-t border-white/5">
              <span class="text-[10px] font-mono uppercase text-slate-400 block mb-1 font-semibold">
                Common Pathologies:
              </span>
              <p class="text-xs text-slate-300 leading-relaxed">
                {item.injuries}
              </p>
            </div>

            <div class="mt-4 pt-3 border-t border-white/5">
              <span class="text-[10px] font-mono uppercase text-emerald-400 block mb-1 font-semibold">
                High Heal Targeted Intervention:
              </span>
              <p class="text-xs text-slate-300 leading-relaxed">
                {item.protocol}
              </p>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-white/10">
            <a 
              href={`/contact?reason=${encodeURIComponent(item.sport + " Consultation")}`}
              class="w-full block text-center py-2.5 rounded-xl bg-slate-900 border border-white/10 text-white font-bold text-xs hover:bg-emerald-500 hover:text-slate-950 transition"
            >
              Book Athletic Assessment →
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Pre-Season Injury Prevention Assessment -->
  <section class="pb-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="glass-panel rounded-3xl p-8 sm:p-12 border border-emerald-500/30 bg-gradient-to-r from-slate-950 via-slate-900 to-emerald-950/30">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-8 space-y-4">
          <span class="badge-tech text-xs px-3 py-1 rounded-full font-mono uppercase tracking-wider font-semibold">
            Proactive Screening
          </span>
          <h3 class="text-2xl sm:text-4xl font-extrabold text-white">
            Pre-Season Athletic Movement & Injury Screen
          </h3>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed max-w-2xl">
            Don't wait for a season-ending tear. Our comprehensive 75-minute screening identifies silent asymmetrical strength deficits, limited ankle dorsiflexion, and knee valgus tendencies before competition begins.
          </p>
          <div class="flex flex-wrap gap-4 text-xs font-mono text-emerald-400 pt-2">
            <span>✓ Functional Movement Screen (FMS)</span>
            <span>✓ Y-Balance Dynamic Stability</span>
            <span>✓ Force Plate Landing Kinetics</span>
          </div>
        </div>
        <div class="lg:col-span-4 text-center lg:text-right">
          <a 
            href="/contact?reason=Pre-Season%20Athletic%20Screen"
            class="inline-block px-8 py-4 rounded-2xl bg-gradient-to-r from-emerald-400 to-cyan-400 text-slate-950 font-extrabold text-xs sm:text-sm hover:opacity-95 transition shadow-xl shadow-emerald-500/25"
          >
            Book Pre-Season Screen →
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>
