---
import Layout from '../layouts/Layout.astro';
---

<Layout activeNav="about" title="About the Doctor & Clinical Leadership | High Heal">
  
  <!-- Header -->
  <section class="pt-16 pb-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto text-center">
    <div class="inline-flex items-center gap-2 badge-medical px-4 py-1.5 rounded-full text-xs font-semibold mb-4 shadow-sm">
      <span class="w-2 h-2 rounded-full bg-teal-600"></span>
      Clinical Leadership & Movement Science
    </div>
    <h1 class="text-4xl sm:text-6xl font-extrabold text-slate-900 tracking-tight">
      Evidence-Based Clinical Mastery
    </h1>
    <p class="text-slate-600 text-base max-w-2xl mx-auto mt-4 leading-relaxed">
      Founded on the principle that modern physical rehabilitation requires precision biomechanics, active loading, and zero compromise on patient recovery time.
    </p>
  </section>

  <!-- Doctor Bio Profile Card -->
  <section class="pb-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="glass-panel rounded-3xl p-8 sm:p-14 border border-slate-200 bg-white shadow-xl grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      
      <!-- Doctor Portrait Placeholder -->
      <div class="lg:col-span-5 text-center">
        <div class="relative inline-block">
          <div class="w-64 h-64 sm:w-80 sm:h-80 rounded-3xl bg-gradient-to-tr from-slate-100 via-teal-50 to-sky-50 border-2 border-teal-500/30 overflow-hidden mx-auto flex items-center justify-center shadow-lg relative group">
            <div class="text-center p-6">
              <div class="w-24 h-24 rounded-full bg-teal-100 text-teal-800 mx-auto flex items-center justify-center text-4xl font-extrabold mb-3 shadow-inner">
                Dr.
              </div>
              <div class="text-sm font-bold text-slate-900 tracking-tight">[Lead Consultant Doctor]</div>
              <div class="text-xs text-teal-700 font-mono mt-1 font-semibold">Founder & Clinical Director</div>
              <p class="text-[10px] text-slate-500 mt-2 max-w-xs">High-resolution portrait can be seamlessly slotted here once provided.</p>
            </div>
          </div>
          
          <div class="absolute -bottom-4 -right-2 bg-white border border-teal-300 text-teal-800 text-xs font-mono px-4 py-1.5 rounded-full shadow-md font-bold">
            MPT (Sports) • MIAP • CDNT
          </div>
        </div>
      </div>

      <!-- Doctor Credentials & Narrative -->
      <div class="lg:col-span-7 space-y-6">
        <div>
          <span class="text-xs font-mono uppercase text-teal-800 font-bold tracking-wider">
            Lead Sports Physiotherapist
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mt-1">
            Dr. [Doctor Name], MPT
          </h2>
          <p class="text-xs font-mono text-teal-700 mt-1 font-semibold">
            Consultant in Sports Medicine, Kinetic Biomechanics & Orthopedic Rehabilitation
          </p>
        </div>

        <blockquote class="text-sm sm:text-base text-slate-700 italic border-l-3 border-teal-600 pl-4 py-1.5 leading-relaxed bg-teal-50/50 rounded-r-xl">
          "The human body is an interconnected kinetic chain. Treating the knee when the fault lies in poor gluteal activation or restricted ankle dorsiflexion guarantees the patient will be back in pain in six months. At High Heal, we diagnose the true mechanical origin."
        </blockquote>

        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          With over a decade of hands-on clinical and on-field experience, the founding team at High Heal has consulted with elite marathoners, national cricket athletes, competitive badminton players, and corporate leaders. We bring the diagnostic rigor used by professional sports clubs to everyday active individuals.
        </p>

        <!-- Credentials Badges Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
          <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200">
            <span class="text-[10px] font-mono uppercase text-slate-500 block font-semibold">Specialized Certifications:</span>
            <div class="text-xs font-bold text-slate-900 mt-1 space-y-0.5">
              <p>• Certified Dry Needling Therapist (CDNT)</p>
              <p>• Mulligan Concept Manual Therapy (CMP)</p>
              <p>• Kinesiology Taping & IASTM Specialist</p>
            </div>
          </div>

          <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200">
            <span class="text-[10px] font-mono uppercase text-slate-500 block font-semibold">Clinical Experience:</span>
            <div class="text-xs font-bold text-slate-900 mt-1 space-y-0.5">
              <p>• 12+ Years Sports Medicine Practice</p>
              <p>• 4,800+ Successful Patient Outcomes</p>
              <p>• Former Consultant to State Athletic Academies</p>
            </div>
          </div>
        </div>

        <div class="pt-2 flex flex-wrap items-center gap-4">
          <a 
            href="/contact?reason=Consultation%20with%20Lead%20Doctor"
            class="px-6 py-3.5 rounded-xl bg-teal-600 text-white font-bold text-xs hover:bg-teal-700 transition shadow-md shadow-teal-600/20"
          >
            Schedule 1-on-1 Consultation →
          </a>
          <a 
            href="https://wa.me/919876543210" 
            target="_blank"
            class="px-5 py-3.5 rounded-xl bg-emerald-50 border border-emerald-300 text-emerald-800 font-semibold text-xs hover:bg-emerald-100 transition"
          >
            Direct WhatsApp Inquiries 💬
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- Clinic Infrastructure Standards -->
  <section class="pb-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="badge-medical text-xs px-3 py-1 rounded-full font-mono uppercase tracking-wider font-semibold">
        Facility Infrastructure
      </span>
      <h2 class="text-3xl font-extrabold text-slate-900 mt-3">Built Different From Ground Up</h2>
      <p class="text-slate-600 text-xs mt-2">Every square foot of High Heal was architected to support active rehabilitation.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <div class="glass-panel rounded-3xl p-7 border border-slate-200 bg-white shadow-sm space-y-3">
        <div class="text-3xl">🏛️</div>
        <h3 class="text-lg font-bold text-slate-900">Private Acoustic Suites</h3>
        <p class="text-xs text-slate-600 leading-relaxed">
          No open curtained bays where your private medical discussions can be overheard. All assessments, manual therapy, and dry needling occur in dedicated, climate-controlled suites.
        </p>
      </div>

      <div class="glass-panel rounded-3xl p-7 border border-slate-200 bg-white shadow-sm space-y-3">
        <div class="text-3xl">🏃‍♂️</div>
        <h3 class="text-lg font-bold text-slate-900">Integrated Rehab Gym Floor</h3>
        <p class="text-xs text-slate-600 leading-relaxed">
          Transition seamlessly from the treatment table to our medical movement floor equipped with Olympic barbells, kettlebells, agility ladders, and turf strips for live deceleration drills.
        </p>
      </div>

      <div class="glass-panel rounded-3xl p-7 border border-slate-200 bg-white shadow-sm space-y-3">
        <div class="text-3xl">🔬</div>
        <h3 class="text-lg font-bold text-slate-900">Objective Sensor Suite</h3>
        <p class="text-xs text-slate-600 leading-relaxed">
          High-speed 240fps cameras, wireless EMG muscle sensors, and digital force dynamometers track your neuromuscular recovery curve week-by-week.
        </p>
      </div>

    </div>
  </section>

</Layout>
