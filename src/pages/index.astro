---
import Layout from '../layouts/Layout.astro';
import AnatomyExplorer from '../components/AnatomyExplorer.tsx';
---

<Layout activeNav="home" title="High Heal | Elite Sports Medicine & Advanced Physiotherapy Clinic">
  
  <!-- HERO SECTION -->
  <section class="pt-12 sm:pt-20 pb-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="text-center max-w-4xl mx-auto">
      
      <!-- Top Badge -->
      <div class="inline-flex items-center gap-2 badge-tech px-4 py-1.5 rounded-full text-xs font-semibold mb-6">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
        Ahmedabad's Premier Sports Rehabilitation & Biomechanics Centre
      </div>

      <!-- Main Heading -->
      <h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight leading-[1.1] text-white">
        Precision Movement.<br />
        <span class="text-gradient-neon">Uncompromising Recovery.</span>
      </h1>

      <!-- Subtitle -->
      <p class="mt-6 text-base sm:text-lg text-slate-400 max-w-2xl mx-auto leading-relaxed">
        High Heal bridges the critical gap between standard clinical therapy and elite sports conditioning. Founded by leading sports physiotherapists, we treat the biomechanical root cause so you never relapse.
      </p>

      <!-- Action Buttons -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a 
          href="/contact" 
          class="px-8 py-4 rounded-2xl bg-gradient-to-r from-emerald-400 to-cyan-400 text-slate-950 font-extrabold text-sm hover:opacity-95 transition shadow-xl shadow-emerald-500/25 flex items-center gap-2.5"
        >
          <span>Schedule Clinical Assessment</span>
          <span>→</span>
        </a>
        <a 
          href="#interactive-anatomy" 
          class="px-8 py-4 rounded-2xl glass-panel text-slate-200 font-semibold text-sm hover:bg-white/10 transition border border-white/10"
        >
          Interactive Pain Navigator ↓
        </a>
      </div>

      <!-- Clinical Performance Metrics -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-16 max-w-4xl mx-auto">
        <div class="glass-panel rounded-2xl p-5 text-center">
          <div class="text-3xl sm:text-4xl font-extrabold font-mono text-white">4,800+</div>
          <div class="text-xs text-slate-400 mt-1 font-medium">Patients Rehabilitated</div>
        </div>
        <div class="glass-panel rounded-2xl p-5 text-center">
          <div class="text-3xl sm:text-4xl font-extrabold font-mono text-emerald-400">96.4%</div>
          <div class="text-xs text-slate-400 mt-1 font-medium">Return-to-Sport Rate</div>
        </div>
        <div class="glass-panel rounded-2xl p-5 text-center">
          <div class="text-3xl sm:text-4xl font-extrabold font-mono text-cyan-400">12+ Yrs</div>
          <div class="text-xs text-slate-400 mt-1 font-medium">Specialized Clinical Practice</div>
        </div>
        <div class="glass-panel rounded-2xl p-5 text-center">
          <div class="text-3xl sm:text-4xl font-extrabold font-mono text-white">4.9 ★</div>
          <div class="text-xs text-slate-400 mt-1 font-medium">Verified Google Clinic Rating</div>
        </div>
      </div>

    </div>
  </section>

  <!-- INTERACTIVE ANATOMY / PAIN NAVIGATOR -->
  <section id="interactive-anatomy" class="py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <AnatomyExplorer client:load />
  </section>

  <!-- BENTO GRID: THE 4 CLINICAL PILLARS (Apple Style) -->
  <section class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span class="badge-tech text-xs px-3 py-1 rounded-full font-mono uppercase tracking-wider font-semibold">
        The High Heal Standard
      </span>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white mt-3 tracking-tight">
        Why Athletes & Executives Choose High Heal
      </h2>
      <p class="text-slate-400 text-sm mt-3">
        Conventional physiotherapy clinics rely on passive hot packs and 10-minute supervised exercises. We deliver active, objective movement science.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- Card 1 (Span 2) -->
      <div class="glass-panel glass-panel-hover rounded-3xl p-8 border border-white/10 md:col-span-2 relative overflow-hidden">
        <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 flex items-center justify-center text-xl font-bold mb-6">
          📊
        </div>
        <h3 class="text-2xl font-bold text-white">Objective Biomechanical Data vs. Guesswork</h3>
        <p class="text-sm text-slate-300 mt-3 max-w-xl leading-relaxed">
          We quantify joint velocity, angular force discrepancies, and kinetic compensation using motion sensors and high-frame video capture. Your rehabilitation is monitored with measurable, verifiable clinical progression.
        </p>
        <div class="mt-6 flex flex-wrap gap-4 text-xs font-mono text-emerald-400">
          <span class="bg-emerald-500/10 px-3 py-1.5 rounded-lg border border-emerald-500/20">✓ 3D Motion Gait Capture</span>
          <span class="bg-emerald-500/10 px-3 py-1.5 rounded-lg border border-emerald-500/20">✓ Force Absorption Symmetry</span>
          <span class="bg-emerald-500/10 px-3 py-1.5 rounded-lg border border-emerald-500/20">✓ Electromyographic Activation</span>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="glass-panel glass-panel-hover rounded-3xl p-8 border border-white/10">
        <div class="w-12 h-12 rounded-2xl bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 flex items-center justify-center text-xl font-bold mb-6">
          ⏱️
        </div>
        <h3 class="text-xl font-bold text-white">Dedicated 1-on-1 Slots</h3>
        <p class="text-xs text-slate-400 mt-3 leading-relaxed">
          Zero double-booked beds or unattended exercises. Every patient receives a full 45 to 60 minute private consultation exclusively with the lead consultant.
        </p>
      </div>

      <!-- Card 3 -->
      <div class="glass-panel glass-panel-hover rounded-3xl p-8 border border-white/10">
        <div class="w-12 h-12 rounded-2xl bg-purple-500/10 border border-purple-500/30 text-purple-400 flex items-center justify-center text-xl font-bold mb-6">
          ⚡
        </div>
        <h3 class="text-xl font-bold text-white">Advanced Invasive Modalities</h3>
        <p class="text-xs text-slate-400 mt-3 leading-relaxed">
          Clinical Dry Needling (CDNT), Instrument-Assisted Soft Tissue Mobilization (IASTM), Radial Shockwave, and Dynamic Pneumatic Recovery Boots.
        </p>
      </div>

      <!-- Card 4 (Span 2) -->
      <div class="glass-panel glass-panel-hover rounded-3xl p-8 border border-white/10 md:col-span-2">
        <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 flex items-center justify-center text-xl font-bold mb-6">
          🎯
        </div>
        <h3 class="text-2xl font-bold text-white">The Bridge to Full Athletic Performance</h3>
        <p class="text-sm text-slate-300 mt-3 max-w-xl leading-relaxed">
          Hospital physiotherapy discharges you the moment you can walk without pain. High Heal continues until you can sprint, cut, decelerate, and jump with 100% psychological confidence.
        </p>
        <div class="mt-4 flex items-center gap-4 text-xs font-mono text-slate-400">
          <span class="text-emerald-400">● 96.4% safe return without reinjury within 12 months</span>
        </div>
      </div>

    </div>
  </section>

  <!-- QUICK TESTIMONIAL / CASE RECOVERY HIGHLIGHTS -->
  <section class="py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t border-white/5">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="badge-tech text-xs px-3 py-1 rounded-full font-mono uppercase tracking-wider font-semibold">
        Clinical Outcomes
      </span>
      <h2 class="text-3xl font-extrabold text-white mt-3">From Acute Trauma to Field Dominance</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <div class="glass-panel rounded-2xl p-6 border border-white/10 space-y-3">
        <div class="flex items-center gap-1 text-emerald-400 text-sm">★★★★★</div>
        <h4 class="text-base font-bold text-white">"Back to Marathon Running in 7 Weeks"</h4>
        <p class="text-xs text-slate-400 leading-relaxed">
          "I had chronic IT band friction and sharp knee pain whenever I hit 5K. Dr. spotted a severe hip drop in my video gait test that two previous clinics missed. The targeted gluteal loading cleared my pain completely."
        </p>
        <div class="pt-2 text-[11px] font-mono text-slate-300">
          — Vikram P., Endurance Runner, Ahmedabad
        </div>
      </div>

      <div class="glass-panel rounded-2xl p-6 border border-white/10 space-y-3">
        <div class="flex items-center gap-1 text-emerald-400 text-sm">★★★★★</div>
        <h4 class="text-base font-bold text-white">"Avoided Lumbar Surgery for L4-L5 Disc"</h4>
        <p class="text-xs text-slate-400 leading-relaxed">
          "As an IT director sitting 12 hours a day, sciatica had made even walking unbearable. High Heal’s spinal decompression protocols and core retraining took my pain from an 8/10 to zero."
        </p>
        <div class="pt-2 text-[11px] font-mono text-slate-300">
          — Rajesh S., VP Engineering, Tech Sector
        </div>
      </div>

      <div class="glass-panel rounded-2xl p-6 border border-white/10 space-y-3">
        <div class="flex items-center gap-1 text-emerald-400 text-sm">★★★★★</div>
        <h4 class="text-base font-bold text-white">"Cricket Fast Bowler Shoulder Relief"</h4>
        <p class="text-xs text-slate-400 leading-relaxed">
          "Suffered a labral impingement that ruined my bowling action. The combination of dry needling, rotator cuff eccentric loading, and kinetic chain drills gave me back 100% throwing velocity."
        </p>
        <div class="pt-2 text-[11px] font-mono text-slate-300">
          — Manan D., District Fast Bowler
        </div>
      </div>

    </div>
  </section>

  <!-- BOTTOM CTA BANNER -->
  <section class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="glass-panel rounded-3xl p-8 sm:p-14 border border-emerald-500/30 text-center relative overflow-hidden bg-gradient-to-b from-slate-900/90 to-emerald-950/20">
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
        Ready to Eliminate Pain at Its Biomechanical Root?
      </h2>
      <p class="mt-4 text-sm sm:text-base text-slate-300 max-w-xl mx-auto">
        Book your dedicated 60-minute initial diagnostic session. Same-day emergency trauma and acute spinal flare-up slots available.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a 
          href="/contact" 
          class="px-8 py-4 rounded-2xl bg-gradient-to-r from-emerald-400 to-cyan-400 text-slate-950 font-extrabold text-sm hover:opacity-95 transition shadow-xl shadow-emerald-500/25"
        >
          Book Your Appointment →
        </a>
        <a 
          href="https://wa.me/919876543210?text=Hi%20High%20Heal%2C%20I%20would%20like%20to%20consult%20regarding%20an%20injury." 
          target="_blank" 
          rel="noopener noreferrer"
          class="px-6 py-4 rounded-2xl glass-panel text-white font-semibold text-sm hover:bg-white/10 transition border border-white/15"
        >
          Chat on WhatsApp 💬
        </a>
      </div>
    </div>
  </section>

</Layout>
