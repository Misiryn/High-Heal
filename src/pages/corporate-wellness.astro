---
import Layout from '../layouts/Layout.astro';
import CorporateCalculator from '../components/CorporateCalculator.tsx';

const corporatePrograms = [
  {
    icon: "🖥️",
    title: "Onsite Workstation Ergonomic Audits",
    description: "Our certified ergonomic specialists visit your office to physically assess workstation setups, chair mechanics, monitor distances, keyboard angles, and ambient illumination.",
    features: [
      "Individual employee postural report card",
      "Chair lumbar, armrest, and desk height calibration",
      "Recommendations for cost-effective ergonomic modifications",
      "Identification of high-risk repetitive strain (RSI) cases"
    ]
  },
  {
    icon: "🧘‍♂️",
    title: "C-Suite & Team Posture Masterclasses",
    description: "High-energy, 45-minute interactive workshops teaching knowledge workers practical 3-minute spinal decompression resets that prevent end-of-day fatigue.",
    features: [
      "Cervical 'tech-neck' deep flexor activation drills",
      "Thoracic extension on office chairs without equipment",
      "Eye fatigue and suboccipital tension headache relief",
      "Proper keyboard and mouse biomechanics to prevent Carpal Tunnel"
    ]
  },
  {
    icon: "💼",
    title: "Executive Priority Physio Retainers",
    description: "Dedicated corporate health pass providing founders, directors, and team members with same-day priority clinical consultations at High Heal.",
    features: [
      "Zero wait time for acute spinal flare-ups or sports injuries",
      "Monthly health check-ins and biomechanical progress tracking",
      "Flexible company billing or subsidized corporate discount codes",
      "Direct WhatsApp concierge for employee appointment scheduling"
    ]
  }
];
---

<Layout activeNav="corporate" title="Corporate Wellness & Workplace Ergonomics | High Heal">
  
  <!-- Header -->
  <section class="pt-16 pb-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto text-center">
    <div class="inline-flex items-center gap-2 badge-medical px-4 py-1.5 rounded-full text-xs font-semibold mb-4 shadow-sm">
      <span class="w-2 h-2 rounded-full bg-teal-600"></span>
      Preventing Musculoskeletal Absenteeism in Modern Workforces
    </div>
    <h1 class="text-4xl sm:text-6xl font-extrabold text-slate-900 tracking-tight">
      High-Performance Teams Need Pain-Free Bodies
    </h1>
    <p class="text-slate-600 text-base max-w-2xl mx-auto mt-4 leading-relaxed">
      Sitting for 8 to 12 hours a day exerts up to 180% more mechanical pressure on the lumbar spine than standing. We help companies protect employee physical health and recover lost productivity.
    </p>
  </section>

  <!-- Interactive ROI Calculator Component -->
  <section class="pb-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <CorporateCalculator client:load />
  </section>

  <!-- 3 Corporate Programs Breakdown -->
  <section class="py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="badge-medical text-xs px-3 py-1 rounded-full font-mono uppercase tracking-wider font-semibold">
        Corporate Packages
      </span>
      <h2 class="text-3xl font-extrabold text-slate-900 mt-3">Structured Corporate Interventions</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {corporatePrograms.map((prog) => (
        <div class="glass-panel glass-panel-hover rounded-3xl p-7 border border-slate-200 bg-white shadow-sm flex flex-col justify-between">
          <div>
            <div class="text-3xl mb-4">{prog.icon}</div>
            <h3 class="text-xl font-bold text-slate-900 leading-snug">{prog.title}</h3>
            <p class="text-xs text-slate-600 mt-3 leading-relaxed">{prog.description}</p>
            
            <div class="mt-6 pt-4 border-t border-slate-100">
              <span class="text-[10px] font-mono uppercase text-teal-800 block mb-2 font-semibold">
                What's Included:
              </span>
              <ul class="text-xs text-slate-700 space-y-2">
                {prog.features.map((feat) => (
                  <li class="flex items-start gap-2">
                    <span class="text-teal-600 font-bold">✓</span>
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="mt-8 pt-4 border-t border-slate-100">
            <a 
              href={`/contact?reason=${encodeURIComponent(prog.title + " Inquiry")}`}
              class="w-full block text-center py-2.5 rounded-xl bg-teal-600 text-white font-bold text-xs hover:bg-teal-700 transition shadow-sm"
            >
              Inquire for Pricing & Dates →
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Corporate Impact Metrics -->
  <section class="pb-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="glass-panel rounded-3xl p-8 sm:p-12 border border-slate-200 bg-white shadow-sm">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
        <div>
          <div class="text-3xl sm:text-4xl font-extrabold font-mono text-teal-700">62%</div>
          <div class="text-xs text-slate-800 font-semibold mt-2">Reduction in Tech-Neck Symptoms</div>
          <p class="text-[11px] text-slate-500 mt-1">Measured after 4 weeks of workstation posture retraining.</p>
        </div>
        <div>
          <div class="text-3xl sm:text-4xl font-extrabold font-mono text-sky-700">2.1 Days</div>
          <div class="text-xs text-slate-800 font-semibold mt-2">Fewer Sick Leaves Per Employee</div>
          <p class="text-[11px] text-slate-500 mt-1">Preventing debilitating sciatica and repetitive strain flare-ups.</p>
        </div>
        <div>
          <div class="text-3xl sm:text-4xl font-extrabold font-mono text-slate-900">4.9 / 5</div>
          <div class="text-xs text-slate-800 font-semibold mt-2">Employee Satisfaction Score</div>
          <p class="text-[11px] text-slate-500 mt-1">Direct feedback from attending interactive wellness masterclasses.</p>
        </div>
      </div>
    </div>
  </section>

</Layout>
